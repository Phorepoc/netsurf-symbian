 			SLEN("class"), &doc->class_string);
@@ -1542,6 +1543,14 @@
 /*-----------------------------------------------------------------------*/
 /* Semi-internal API extensions for NetSurf */
 
+/* Phorepoc: mark a document a script built (createDocument, createHTMLDocument, a frame's contentDocument). No
+ * browser content lays it out, so the DOM rule that its root Element / DocumentType may be removed or replaced
+ * applies; the live rendered document keeps libdom's refusal. */
+void _dom_document_set_scripted(dom_document *doc)
+{
+	doc->scripted = true;
+}
+
