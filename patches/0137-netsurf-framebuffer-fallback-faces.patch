diff -ru a/netsurf/frontends/framebuffer/font_freetype.c b/netsurf/frontends/framebuffer/font_freetype.c
--- a/netsurf/frontends/framebuffer/font_freetype.c	2026-11-14 22:04:48.551053700 +0000
+++ b/netsurf/frontends/framebuffer/font_freetype.c	2026-11-14 22:05:27.955772400 +0000
@@ -81,6 +81,13 @@
 
 static fb_faceid_t *fb_faces[FB_FACE_COUNT];
 
+/* fallback faces (option fb_face_fallback): a character the chosen face has
+ * no glyph for is taken from the first of these that has one, instead of
+ * drawing the face's missing-glyph box */
+#define FB_FALLBACK_MAX 8
+static fb_faceid_t *fb_fallback[FB_FALLBACK_MAX];
+static int fb_fallback_count;
+
 /*
  * Family-name handling.
  *
@@ -313,7 +320,7 @@
 {
         FT_Error error;
         FT_ULong max_cache_size;
-        FT_UInt max_faces = 6;
+        FT_UInt max_faces = 6 + FB_FALLBACK_MAX;
 	fb_faceid_t *fb_face;
 
         /* freetype library initialise */
@@ -467,6 +474,27 @@
 		fb_faces[FB_FACE_FANTASY] = fb_face;
 	}
 
+	/* fallback faces */
+	fb_fallback_count = 0;
+	if (nsoption_charp(fb_face_fallback) != NULL) {
+		char *list = strdup(nsoption_charp(fb_face_fallback));
+		char *path = list;
+		while (list != NULL && path != NULL && *path != '\0' &&
+		       fb_fallback_count < FB_FALLBACK_MAX) {
+			char *end = strchr(path, ';');
+			if (end != NULL)
+				*end = '\0';
+			if (*path != '\0') {
+				fb_face = fb_new_face(path, NULL, path);
+				if (fb_face != NULL)
+					fb_fallback[fb_fallback_count++] = fb_face;
+			}
+			path = (end != NULL) ? end + 1 : NULL;
+		}
+		free(list);
+		NSLOG(netsurf, INFO, "%d fallback faces", fb_fallback_count);
+	}
+
         
         /* set the default render mode */
         if (nsoption_bool(fb_font_monochrome) == true)
@@ -485,6 +513,13 @@
         FTC_Manager_Done(ft_cmanager);
         FT_Done_FreeType(library);
 
+	for (i = 0; i < fb_fallback_count; i++) {
+		free(fb_fallback[i]->fontfile);
+		free(fb_fallback[i]);
+		fb_fallback[i] = NULL;
+	}
+	fb_fallback_count = 0;
+
 	for (i = 0; i < FB_FACE_COUNT; i++) {
 		if (fb_faces[i] == NULL)
 			continue;
@@ -595,6 +630,20 @@
         glyph_index = FTC_CMapCache_Lookup(ft_cmap_cache, srec.face_id,
 			fb_face->cidx, ucs4);
 
+	if (glyph_index == 0 && ucs4 > 0x20) {
+		int i;
+		for (i = 0; i < fb_fallback_count; i++) {
+			FT_UInt fi = FTC_CMapCache_Lookup(ft_cmap_cache,
+					(FTC_FaceID)fb_fallback[i],
+					fb_fallback[i]->cidx, ucs4);
+			if (fi != 0) {
+				srec.face_id = (FTC_FaceID)fb_fallback[i];
+				glyph_index = fi;
+				break;
+			}
+		}
+	}
+
         error = FTC_ImageCache_LookupScaler(ft_image_cache, 
                                             &srec, 
                                             FT_LOAD_RENDER | 
