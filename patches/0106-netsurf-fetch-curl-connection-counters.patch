@@ -283,9 +283,50 @@
 static mbedtls_x509_crt ns_ca_chain;
 static bool ns_ca_loaded;
 
+/* Phorepoc: counters for the engine's heap log line -- open curl sockets (a page's connections, TLS for https) and TLS
+ * sessions set up so far; the engine thread is the only user, so plain ints. */
+#include <sys/socket.h>
+#include <unistd.h>
+int phns_tls_live, phns_tls_sessions;
+extern long phns_heap_alloc(void);
+
+/* PSA key slots in use (every TLS key of mbedTLS 3.6 with MBEDTLS_USE_PSA_CRYPTO lives in one); *pool = the fixed slot
+ * count, 0 when the key store grows on the heap (MBEDTLS_PSA_KEY_STORE_DYNAMIC) */
+#include <psa/crypto.h>
+int phns_psa_keys(int *pool)
+{
+	mbedtls_psa_stats_t st;
+	mbedtls_psa_get_stats(&st);
+#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)
+	*pool = 0;
+#else
+	*pool = (int)(st.MBEDTLS_PRIVATE(volatile_slots) + st.MBEDTLS_PRIVATE(persistent_slots) + st.MBEDTLS_PRIVATE(external_slots) + st.MBEDTLS_PRIVATE(half_filled_slots) +
+		      st.MBEDTLS_PRIVATE(cache_slots) + st.MBEDTLS_PRIVATE(empty_slots));
+#endif
+	return (int)(st.MBEDTLS_PRIVATE(volatile_slots) + st.MBEDTLS_PRIVATE(persistent_slots) + st.MBEDTLS_PRIVATE(external_slots));
+}
+
+static curl_socket_t fetch_curl_opensocket(void *clientp, curlsocktype purpose, struct curl_sockaddr *a)
+{
+	curl_socket_t s;
+	(void)clientp; (void)purpose;
+	s = socket(a->family, a->socktype, a->protocol);
+	if (s != CURL_SOCKET_BAD)
+		phns_tls_live++;
+	return s;
+}
+
+static int fetch_curl_closesocket(void *clientp, curl_socket_t s)
+{
+	(void)clientp;
+	phns_tls_live--;
+	return close(s);
+}
