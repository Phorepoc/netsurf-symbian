+/**
+ * Parse a calc() media feature value, e.g. (max-width: calc(1120px - 1px)).
+ *
+ * The 'calc(' function token is already consumed. Supported: a sum of terms
+ * (+ / -), each a number or dimension optionally multiplied or divided by
+ * numbers; every dimension must have the same unit. That covers the
+ * breakpoint arithmetic sites use; anything else is invalid, as before.
+ */
+static css_error mq_parse_calc(const parserutils_vector *vector, int32_t *ctx,
+		css_mq_value *value)
+{
+	const css_token *token;
+	css_fixed sum = 0;
+	uint32_t unit = 0;
+	bool have_unit = false;
+	bool negate = false;
+	bool any = false;
+
+	for (;;) {
+		css_fixed term;
+		uint32_t term_unit = 0;
+		bool term_dim = false;
+		size_t consumed;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL)
+			return CSS_INVALID;
+
+		if (token->type == CSS_TOKEN_NUMBER) {
+			term = css__number_from_lwc_string(token->idata, false,
+					&consumed);
+		} else if (token->type == CSS_TOKEN_DIMENSION) {
+			size_t len = lwc_string_length(token->idata);
+			const char *data = lwc_string_data(token->idata);
+			term = css__number_from_lwc_string(token->idata, false,
+					&consumed);
+			if (css__parse_unit_keyword(data + consumed,
+					len - consumed, &term_unit) != CSS_OK)
+				return CSS_INVALID;
+			term_dim = true;
+		} else {
+			return CSS_INVALID;
+		}
+
+		/* term (* | /) number ... */
+		for (;;) {
+			const css_token *op, *num;
+			consumeWhitespace(vector, ctx);
+			op = parserutils_vector_peek(vector, *ctx);
+			if (!tokenIsChar(op, '*') && !tokenIsChar(op, '/'))
+				break;
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+			num = parserutils_vector_iterate(vector, ctx);
+			if (num == NULL || num->type != CSS_TOKEN_NUMBER)
+				return CSS_INVALID;
+			if (tokenIsChar(op, '*')) {
+				term = FMUL(term, css__number_from_lwc_string(
+						num->idata, false, &consumed));
+			} else {
+				css_fixed d = css__number_from_lwc_string(
+						num->idata, false, &consumed);
+				if (d == 0)
+					return CSS_INVALID;
+				term = FDIV(term, d);
+			}
+		}
+
+		if (term_dim) {
+			if (have_unit && term_unit != unit)
+				return CSS_INVALID;
+			unit = term_unit;
+			have_unit = true;
+		}
+		sum = negate ? FSUB(sum, term) : FADD(sum, term);
+		any = true;
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (tokenIsChar(token, ')'))
+			break;
+		if (tokenIsChar(token, '+'))
+			negate = false;
+		else if (tokenIsChar(token, '-'))
+			negate = true;
+		else
+			return CSS_INVALID;
+	}
+
+	if (!any)
+		return CSS_INVALID;
+	if (have_unit) {
+		value->type = CSS_MQ_VALUE_TYPE_DIM;
+		value->data.dim.len = sum;
+		value->data.dim.unit = unit;
+	} else {
+		value->type = CSS_MQ_VALUE_TYPE_NUM;
+		value->data.num_or_ratio = sum;
+	}
+	return CSS_OK;
+}
