+/* the URL of the document the script belongs to (after redirects). The
+ * browser window's URL is the previous page while this one is still
+ * loading, so location/document.URL read during the load pointed at the
+ * last page (a script that rebuilt location.href then navigated back to it) */
+static struct nsurl *qjs_doc_url(struct jsthread *t)
+{
+	if (t->htmlc != NULL) {
+		struct nsurl *u = content_get_url(&t->htmlc->base);
+		if (u != NULL)
+			return u;
+	}
+	return browser_window_access_url(t->bw);
+}
+
