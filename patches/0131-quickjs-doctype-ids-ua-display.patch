+/** __ns.doctypeIds(node) -> [publicId, systemId] of a DocumentType node */
+static JSValue nat_doctype_ids(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct jsthread *t = nat_thread(ctx);
+	dom_node *node;
+	dom_string *pub = NULL, *sys = NULL;
+	JSValue arr;
+
+	if (t == NULL || argc < 1)
+		return JS_NULL;
+	node = nat_node(t, argv[0]);
+	if (node == NULL)
+		return JS_NULL;
+	arr = JS_NewArray(ctx);
+	dom_document_type_get_public_id((dom_document_type *)node, &pub);
+	dom_document_type_get_system_id((dom_document_type *)node, &sys);
+	JS_SetPropertyUint32(ctx, arr, 0, pub != NULL ?
+		JS_NewStringLen(ctx, dom_string_data(pub), dom_string_byte_length(pub)) : JS_NewString(ctx, ""));
+	JS_SetPropertyUint32(ctx, arr, 1, sys != NULL ?
+		JS_NewStringLen(ctx, dom_string_data(sys), dom_string_byte_length(sys)) : JS_NewString(ctx, ""));
+	if (pub != NULL)
+		dom_string_unref(pub);
+	if (sys != NULL)
+		dom_string_unref(sys);
+	return arr;
+}
